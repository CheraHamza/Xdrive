<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Xdrive - <%= title %></title>
  <link rel="icon" type="image/svg+xml" href="icons/light-logo.svg">
  <link rel="stylesheet" href="css/style.css">
  <script src="js/forms.js" defer></script>
</head>

<body>
  <div class="page-container signup-page">

    <div class="hero-section">
      <%- include("partials/logo-composite") %>

      <p class="small text-label">Personal cloud storage for your important <span>(but tiny)</span> files.</p>
    </div>



    <div class="form-wrapper">

      <div class="form-header">
        <h2 class="big medium">Create your account</h2>
        <p class="text-label gray small">Join to claim your personal cloud storage.</p>
      </div>


      <form action="/signup" method="post">
        <div class="input-err-wrapper">
          <span class="error-msg"><%= locals.errors?.name?.[0] %></span>
          <div class="input-wrapper name">
            <label class="text-label small gray" for="name">Name</label>
            <input id="name" name="name" type="text" placeholder="Full Name" value="<%= locals.previousValues?.name %>">
          </div>
        </div>
        <div class="input-err-wrapper">
          <span class="error-msg"><%= locals.errors?.email?.[0] %></span>
          <div class="input-wrapper email">
            <label class="text-label small gray" for="email">EMAIL</label>
            <input id="email" name="email" type="email" placeholder="user@xdrive.com" value="<%= locals.previousValues?.email %>">
          </div>
        </div>
        <div class="input-err-wrapper">
          <span class="error-msg"><%= locals.errors?.password?.[0] %></span>
          <div class="input-wrapper password">
            <label class="text-label small gray" for="password">PASSWORD</label>
            <input id="password" name="password" type="password" placeholder="Min. 8 characters">
          </div>
        </div>
        <div class="input-err-wrapper">
          <span class="error-msg"><%= locals.errors?.["confirm-password"]?.[0] %></span>
          <div class="input-wrapper password">
            <label class="text-label small gray" for="confirm-password">CONFIRM PASSWORD</label>
            <input id="confirm-password" name="confirm-password" type="password" placeholder="Min. 8 characters">
          </div>
        </div>

        <button type="submit" class="submit-button text-label normal">Create account</button>
      </form>

      <p class="signup-prompt text-label small gray">Already have an account? <a href="/login">Log in</a></p>
    </div>

  </div>

</body>

</html>