<div class="modal add-folder">
  <form class="add-folder-form" action="/createFolder" method="post">

    <input type="hidden" id="currentFolderId" name="currentFolderId" value="<%= locals.currentFolderId?? '' %>">

    <label for="foldername" class="big text-label">New Folder</label>
    <input class="normal" id="foldername" type="text" name="foldername" placeholder="New folder">

    <div class="btns-wrapper">
      <button type="button" class="cancel-btn medium text-label">Cancel</button>
      <button type="submit" class="submit-btn medium text-label">Create</button>
    </div>

  </form>
</div>

<div class="modal rename-item">
  <form class="rename-item-form" method="post">

    <input type="hidden" name="itemId" id="itemId">
    <label for="name" class="big text-label">Rename</label>
    <input class="normal" id="name" type="text" name="name" placeholder="New name">

    <div class="btns-wrapper">
      <button type="button" class="cancel-btn medium text-label">Cancel</button>
      <button type="submit" class="submit-btn medium text-label">Rename</button>
    </div>

  </form>
</div>


<div class="modal move-item">
  <form class="move-item-form" method="post">
    <input type="hidden" name="itemId" id="itemIdToMove">
    <input type="hidden" name="destinationFolderId" id="destinationFolderId">

    <label class="big text-label">Move Item To...</label>

    <div class="folder-tree-container"></div>

    <div class="btns-wrapper">
      <button type="button" class="cancel-btn medium text-label">Cancel</button>
    </div>
  </form>
</div>

<div class="modal item-details">
  <div class="details-wrapper">
    <div class="title big text-label">
    </div>
    <div class="rows-container">
      <div class="row">
        <div class="name-label thin gray text-label">Name</div>
        <div class="name-value text-label"></div>
      </div>
      <div class="row">
        <div class="type-label thin gray text-label">Type</div>
        <div class="type-value"></div>
      </div>
      <div class="row">
        <div class="size-label thin gray text-label">Size</div>
        <div class="size-value"></div>
      </div>
      <div class="row">
        <div class="time-lable thin gray text-label"></div>
        <div class="time-value"></div>
      </div>
      <div class="row">
        <div class="location-label thin gray text-label">Location</div>
        <div class="location-value"></div>
      </div>
      <div class="row">
        <div class="owner-label thin gray text-label">Owner</div>
        <div class="owner-value"></div>
      </div>
    </div>

    <div class="btns-wrapper">
      <button type="button" class="cancel-btn medium text-label">Close</button>
    </div>
  </div>
</div>

<div class="modal delete-item">
  <form method="post">
    <input id="itemId" name="itemId" type="hidden">

    <div class="title big text-label">Delete forever?</div>
    <p class="thin gray text-label"><span class="item-name"></span> will be deleted forever. This can't be undone.</p>

    <div class="btns-wrapper">
      <button type="button" class="cancel-btn medium text-label">Cancel</button>
      <button type="submit" class="submit-btn medium text-label">Delete forever</button>
    </div>
  </form>
</div>

<div class="modal empty-trash">
  <form action="/empty-trash" method="post">
    <div class="title big text-label">Delete forever?</div>
    <p class="thin gray text-label">All items in the trash will be deleted forever. This can't be undone.</p>

    <div class="btns-wrapper">
      <button type="button" class="cancel-btn medium text-label">Cancel</button>
      <button type="submit" class="submit-btn medium text-label">Delete forever</button>
    </div>
  </form>
</div>

<div class="modal share-item ">

  <div class="share-config-view">
    <form class="share-item-form" method="post">
      <div class="title big text-label"></div>

      <input type="hidden" id="itemId" name="itemId">

      <div class="access-wrapper">
        <label for="access" class="gray text-label small">General access:</label>
        <select name="access" id="access" class="text-label">
          <option value="RESTRICTED">Restricted</option>
          <option value="PUBLIC">Public</option>
        </select>
        <span class="material-symbols-outlined access-icon gray">lock</span>
      </div>

      <div class="duration-wrapper">
        <label for="duration" class="gray text-label small">Duration:</label>
        <select class="text-label" name="duration" id="duration">
          <option class="text-label" value="forever">Forever</option>
          <option class="text-label" value="timed">Timed</option>
        </select>
      </div>

      <div class="timer-wrapper">

        <div class="text-label gray small header">Set timer</div>

        <div class="incrementer-wrapper">
          <div class="incrementer">
            <button type="button" class="incBtn days-up">
              <span class="material-symbols-outlined">arrow_drop_up</span>
            </button>
            <input type="number" id="days" name="days" min="0" placeholder="0" value="0">
            <button type="button" class="incBtn days-down">
              <span class="material-symbols-outlined">arrow_drop_down</span>
            </button>
          </div>

          <label for="days" class="gray text-label small">Days</label>

          <div class="incrementer">
            <button type="button" class="incBtn hours-up">
              <span class="material-symbols-outlined">arrow_drop_up</span>
            </button>
            <input type="number" id="hours" name="hours" max="24" min="0" placeholder="0" value="0">
            <button type="button" class="incBtn hours-down">
              <span class="material-symbols-outlined">arrow_drop_down</span>
            </button>
          </div>

          <label for="hours" class="gray text-label small">Hours</label>

          <div class="incrementer">
            <button type="button" class="incBtn minutes-up">
              <span class="material-symbols-outlined">arrow_drop_up</span>
            </button>
            <input type="number" id="minutes" name="minutes" max="60" min="0" placeholder="0" value="0">
            <button type="button" class="incBtn minutes-down">
              <span class="material-symbols-outlined">arrow_drop_down</span>
            </button>
          </div>

          <label for="minutes" class="gray text-label small">Minutes</label>
        </div>
      </div>

      <div class="btns-wrapper">
        <button type="button" class="cancel-btn medium text-label">Cancel</button>
        <button type="submit" class="submit-btn medium text-label">Generate Link</button>
      </div>
    </form>
  </div>

  <div class="share-link-view hidden">
    <div class="title big text-label">Share Link Ready</div>

    <div class="link-wrapper">
      <label for="shareLinkInput" class="text-label gray small">Anyone with this link can view:</label>
      <div class="link-row">
        <input readonly id="shareLinkInput" type="text" value="">
        <button type="button" class="copyBtn" id="copyLinkBtn">
          <span class="material-symbols-outlined">content_copy</span>
        </button>
      </div>
    </div>

    <div class="expiration-info-row">
      <span id="linkExpirationBadge" class="gray text-label small"></span>
    </div>

    <div class="btns-wrapper">
      <button type="button" id="editShareSettingsBtn" class="medium text-label">Edit Settings</button>
      <button type="button" id="doneShareBtn" class="medium text-label">Done</button>
    </div>
  </div>

</div>