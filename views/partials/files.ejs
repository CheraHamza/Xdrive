<div class="files-container">
  <% if (locals.files) { %>
  <% files.forEach(file => { %>
  <div class="file" id="<%= file?.id %>" data-url="<%= file?.path %>" data-name="<%= file?.name %>" tabindex="0">
    <div class="preview-wrapper">
      <% if (file?.type == "image") {%>
      <img src="<%= file?.path %>" class="<%= file?.name.endsWith(".gif") ? 'gif-thumbnail' : '' %>" alt="Preview">
      <% } else if (file?.type == "movie") { %>
      <video src="<%= file?.path %>" alt="" preload="metadata" muted playsinline disablePictureInPicture></video>
      <% } else { %>
      <span class="material-symbols-outlined file-icon <%= file?.type %>"><%= file?.icon %></span>
      <% } %>
    </div>

    <div class="file-name-wrapper">
      <span class="material-symbols-outlined file-icon <%= file?.type %>">
        <%= file?.icon %>
      </span>
      <span class="thin small text-label file-name"><%= file?.name %></span>
      <div class="file-menu-wrapper">
        <button class="file-menu-btn">
          <span class="material-symbols-outlined file-menu-icon">more_vert</span>
        </button>
        <%-include("drop-down", {file}) %>
      </div>
    </div>


    <form class="star-form" action="/star" method="post">
      <input id="fileId" name="fileId" type="hidden" value="<%= file?.id %>">
      <input id="starred" name="starred" type="hidden" value="<%= file?.starred %>">
      <button type="submit" class="material-symbols-outlined star-btn <%= file.starred ? 'starred' : '' %>">star</button>
    </form>

  </div>
  <% }); %>
  <% } %>
</div>

<script src="js/files.js" defer> </script>