<% const isFolder = locals.isFolder || false; %>
<% const item = locals.item; %>

<div class="item-dropdown" data-id="<%= item?.id %>">

  <% if (!item.trashed) { %>
  <button class="open-item">
    <span class="material-symbols-outlined icon">open_in_new</span>
    <span>Open</span>
  </button>

  <% if (locals.sharedBrowse) { %>
  <form class="download-form" action="<%= item.sharedDownloadUrl %>" method="get">
    <button class="download-item" type="submit">
      <span class="material-symbols-outlined icon">download</span>
      <span>Download</span>
    </button>
  </form>
  <% } else { %>
  <form class="download-form" action="<%= isFolder ? '/download-folder' : '/download-file' %>" method="post">
    <% if (isFolder) { %>
    <input id="folderId" name="folderId" type="hidden" value="<%= item?.id %>">
    <% } else { %>
    <input id="fileId" name="fileId" type="hidden" value="<%= item?.id %>">
    <% } %>
    <button class="download-item" type="submit">
      <span class="material-symbols-outlined icon">download</span>
      <span>Download</span>
    </button>
  </form>

  <button class="rename-item">
    <span class="material-symbols-outlined icon">edit_square</span>
    <span>Rename</span>
  </button>

  <button class="move-item">
    <span class="material-symbols-outlined icon">drive_file_move</span>
    <span>Move</span>
  </button>

  <button class="item-details">
    <span class="material-symbols-outlined icon">info</span>
    <span>Details</span>
  </button>

  <button class="share-item">
    <span class="material-symbols-outlined icon">share</span>
    <span>Share</span>
  </button>

  <form method="post" action="<%= isFolder ? '/trash-folder' : '/trash-file' %>">
    <input type="hidden" name="itemId" value="<%= item.id %>">
    <button type="submit" class="trash-item">
      <span class="material-symbols-outlined icon">delete</span>
      <span>Move to trash</span>
    </button>
  </form>
  <% } %>


  <% } else { %>

  <form method="post" action="<%= isFolder ? '/restore-folder' : '/restore-file' %>">
    <input name="itemId" type="hidden" value="<%= item.id %>">
    <button type="submit" class="restore-item">
      <span class="material-symbols-outlined icon">history</span>
      <span>Restore</span>
    </button>
  </form>


  <button class="delete-item">
    <span class="material-symbols-outlined icon">delete_forever</span>
    <span>Delete forever</span>
  </button>

  <% } %>
</div>