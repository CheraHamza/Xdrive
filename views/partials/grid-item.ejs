<% const isFolder = locals.isFolder || false; %>
<% const item = locals.item; %>
<% const previewUrl = item?.sharedOpenUrl || `/open-file/${item?.id}`; %>
<div class="item" id="<%= item?.id %>" data-type="<%= isFolder ? 'folder' : 'file' %>" data-name="<%= item?.name %>" data-trashed="<%= item?.trashed ? 'true' : 'false' %>" tabindex="0" data-tooltip="<%= item?.name %>" data-open-url="<%= item?.sharedOpenUrl || '' %>" <% if (!isFolder) {%> data-url="<%= previewUrl %>" <% } %>>
  <div class="preview-wrapper">
    <% if (isFolder) { %>
    <span class="material-symbols-outlined item-icon folder">folder</span>
    <% } else if (item?.type == "image") { %>
    <img src="<%= previewUrl %>" class="<%= item?.name.endsWith('.gif') ? 'gif-thumbnail' : '' %>" alt="Preview" loading="lazy" decoding="async" fetchpriority="low">
    <% } else if (item?.type == "movie") { %>
    <video src="<%= previewUrl %>" preload="metadata" muted playsinline disablePictureInPicture></video>
    <% } else { %><span class="material-symbols-outlined item-icon <%= item?.type %>">
      <%= item?.icon %>
    </span>
    <% } %>
  </div>
  <div class="item-name-wrapper"> <span class="material-symbols-outlined item-icon <%= !isFolder ? item?.type : 'folder' %>">
      <%= isFolder ? 'folder' : item?.icon %>
    </span> <span class="thin small text-label item-name">
      <%= item?.name %>
    </span>
    <div class="item-menu-wrapper"> <button class="item-menu-btn"> <span class="material-symbols-outlined item-menu-icon">more_vert</span>
      </button>
      <%- include("item-dropdown", {item: item, isFolder: isFolder, sharedBrowse: locals.sharedBrowse || false}) %>
    </div>
  </div>
  <% if (!item.trashed) { %>
  <form class="star-form" action="<%= isFolder ? '/star-folder' : '/star-file' %>" method="post"> <input name="itemId" type="hidden" value="<%= item?.id %>"> <input id="starred" name="starred" type="hidden" value="<%= item?.starred %>"> <button type="submit" class="material-symbols-outlined star-btn <%= item?.starred ? 'starred' : '' %>">star</button>
  </form>
  <% } %>
</div>