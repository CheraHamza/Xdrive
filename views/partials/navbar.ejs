<nav class="navbar">
  <%- include("logo-composite") %>

  <div class="new-btn-wrapper">
    <button class="new-btn medium">
      <span class="material-symbols-outlined add-icon">
        add
      </span>
      <span class="normal thin">
        New
      </span>
    </button>

    <div class="new-dropdown">
      <button class="new-folder-btn">
        <span class="material-symbols-outlined">create_new_folder</span>
        <span class="small text-label">New folder</span>
      </button>
      <hr>
      <button class="upload-file-btn">
        <span class="material-symbols-outlined">upload_file</span>
        <span class="small text-label">File upload</span>
      </button>
      <form class="upload-form" action="/upload" method="post" enctype="multipart/form-data">
        <input id="file" type="file" name="file">
      </form>
    </div>
    <div class="">

    </div>
  </div>

  <div class="nav-btns">
    <button class="home-btn active">
      <span class="material-symbols-outlined home-icon">home</span>
      <span class="medium">Home</span>
    </button>
    <button class="starred-btn">
      <span class="material-symbols-outlined starred-btn">
        star
      </span>
      <span class="medium">Starred</span>
    </button>
    <button class="shared-btn">
      <span class="material-symbols-outlined shared-btn">
        group
      </span>
      <span class="medium">Shared</span>
    </button>
    <button class="trash-btn">
      <span class="material-symbols-outlined trash-btn">
        delete
      </span>
      <span class="medium">Trash</span>
    </button>
  </div>
</nav>

<script defer>
  const newBtn = document.querySelector(".new-btn")
  const dropDown = document.querySelector(".new-dropdown");

  newBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    newBtn.classList.toggle("active");

    if (newBtn.classList.contains("active")) {
      dropDown.style.display = "flex";

    } else {
      dropDown.style.display = "none";
    }
  })

  document.addEventListener('click', (e) => {
    newBtn.classList.remove('active');
    dropDown.style.display = 'none';

  });
</script>


<script defer>
  const newFolderBtn = document.querySelector(".new-folder-btn");
  const fullViewForm = document.querySelector(".full-view-form.add-folder");
  const newFolderForm = fullViewForm.querySelector("form");

  const inputField = newFolderForm.querySelector("input");

  newFolderBtn.addEventListener("click", () => {
    fullViewForm.classList.toggle("active");

    if (fullViewForm.classList.contains("active")) {
      inputField.focus();
    }
  })

  fullViewForm.addEventListener('click', (e) => {
    e.stopPropagation();

    if (!newFolderForm.contains(e.target)) {
      fullViewForm.classList.remove('active');
    }

  });

  const cancelBtn = newFolderForm.querySelector(".cancel-btn");

  cancelBtn.addEventListener("click", () => {
    inputField.value = "New folder";
    fullViewForm.classList.remove('active');
  })
</script>