<nav class="navbar" id="primary-navigation">
  <%- include("logo-composite") %>

  <div class="new-btn-wrapper">
    <button type="button" class="new-btn medium">
      <span class="material-symbols-outlined add-icon">
        add
      </span>
      <span class="normal">
        New
      </span>
    </button>

    <form class="upload-form" action="/upload" method="post" enctype="multipart/form-data" data-loading-text="Uploading file...">
      <input type="hidden" id="currentFolderId" name="currentFolderId" value="<%= locals.currentFolderId?? '' %>">
      <input id="file" type="file" name="file">
    </form>
  </div>

  <div class="nav-btns">
    <a href="/home">
      <button class="home-btn <%= locals.location?.[0]?.name === "Home"? "active" : "" %>">
        <span class="material-symbols-outlined home-icon">home</span>
        <span class="medium">Home</span>
      </button>
    </a>

    <a href="/starred">
      <button class="starred-btn <%= locals.location?.[0]?.name === "Starred"? "active" : "" %>">
        <span class="material-symbols-outlined starred-btn">
          star
        </span>
        <span class="medium">Starred</span>
      </button>
    </a>

    <a href="/shared">
      <button class="shared-btn <%= locals.location?.[0]?.name === "Shared"? "active" : "" %>">
        <span class="material-symbols-outlined shared-btn">
          group
        </span>
        <span class="medium">Shared</span>
      </button>
    </a>

    <a href="/trash">
      <button class="trash-btn <%= locals.location?.[0]?.name === "Trash"? "active" : "" %>">
        <span class="material-symbols-outlined trash-btn">
          delete
        </span>
        <span class="medium">Trash</span>
      </button>
    </a>



  </div>

  <% if (locals.currentUser) { %>
  <div class="account-banner">
    <div class="account-summary">
      <div class="avatar" style="--avatar-hue: <%= (locals.currentUser.name || 'U').charCodeAt(0) * 7 %>deg">
        <%= (locals.currentUser.name || "U").charAt(0).toUpperCase() %>
      </div>
      <div class="account-info">
        <div class="account-name" title="<%= locals.currentUser.name || 'User' %>">
          <%= locals.currentUser.name || "User" %>
        </div>
        <div class="storage-label">
          <%= locals.storageUsage?.percentage || 0 %>% of <%= locals.storageUsage?.limitLabel || "quota" %>
        </div>
      </div>
    </div>
    <div class="storage-bar" role="progressbar" aria-label="Storage used" aria-valuemin="0" aria-valuemax="100" ariavaluenow="<%= locals.storageUsage?.percentage || 0 %>">
      <div class="storage-bar-fill" style="width: <%= locals.storageUsage?.percentage || 0 %>%"></div>
    </div>
  </div>
  <% } %>
</nav>
<div class="nav-overlay" aria-hidden="true"></div>