<header>
  <% if (locals.isAuthenticated) { %>
  <div class="input-wrapper">
    <form action="/search" method="get">
      <span class="material-symbols-outlined search-icon big">search</span>
      <input type="search" name="search" id="search" placeholder="Search in Xdrive" value="<%= locals.searchQuery ? locals.searchQuery : "" %>">
    </form>
  </div>


  <div class="settings-wrapper">
    <button class="settings-btn">
      <span class="material-symbols-outlined">settings</span>
    </button>

    <div class="settings-dropdown">
      <h1 class="normal medium">Settings</h1>
      <div class="dropdown-btns">
        <button class="support-btn text-label">
          <span class="material-symbols-outlined icon">help</span>
          <span class="">Support</span>
        </button>
        <form action="/logout" method="post">
          <button class="logout-btn text-label">Log out</button>
        </form>
      </div>
    </div>
  </div>

  <% } else { %>
  <%- include("logo-composite") %>
  <div class="auth-btns">
    <a href="/login">
      <button class="login-btn medium">Log in</button>
    </a>
    <a href="/signup">
      <button class="signup-btn medium">Sign up</button>
    </a>
    <% } %>
</header>

<% if (!locals.isAuthenticated) { %>
<hr>
<% } %>

<script defer>
  const settingsBtn = document.querySelector('.settings-btn');
  const settingsDropdown = document.querySelector('.settings-dropdown');

  const closeSettingsMenu = () => {
    settingsBtn?.classList.remove('active');
    if (settingsDropdown) {
      settingsDropdown.style.display = 'none';
    }
  };

  settingsBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    settingsBtn.classList.toggle('active');

    if (settingsBtn.classList.contains('active')) {
      settingsDropdown.style.display = 'flex';
    } else {
      closeSettingsMenu();
    }
  });

  settingsDropdown?.addEventListener('click', (e) => {
    if (e.target.closest('button')) {
      closeSettingsMenu();
    }
  });

  document.addEventListener('click', (e) => {
    if (!settingsDropdown?.contains(e.target)) {
      closeSettingsMenu();
    }
  });
</script>