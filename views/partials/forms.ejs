<div class="full-view-form add-folder">
  <form class="add-folder-form" action="/addFolder" method="post">

    <label for="folder-name" class="big text-label">New Folder</label>
    <input class="normal" id="folder-name" type="text" name="folder-name" placeholder="New folder">

    <div class="btns-wrapper">
      <button type="button" class="cancel-btn medium text-label">Cancel</button>
      <button type="submit" class="submit-btn medium text-label">Create</button>
    </div>

  </form>
</div>

<div class="full-view-form rename-file">
  <form class="rename-file-form" action="/rename" method="post">

    <input type="hidden" name="fileID" id="fileID">
    <label for="filename" class="big text-label">Rename</label>
    <input class="normal" id="filename" type="text" name="filename" placeholder="New name">

    <div class="btns-wrapper">
      <button type="button" class="cancel-btn medium text-label">Cancel</button>
      <button type="submit" class="submit-btn medium text-label">Rename</button>
    </div>

  </form>
</div>