<div class="file-dropdown" data-fileId="<%= file?.id %>">
  <button class="file-dropdown-option open-file">
    <span class="material-symbols-outlined icon">open_in_new</span>
    <span>Open</span>
  </button>
  <form class="download-form" action="/download" method="post">
    <input id="fileName" name="fileName" type="hidden" value="<%= file?.name %>">
    <input id="filePath" name="filePath" type="hidden" value="<%= file?.path %>">
    <button class="file-dropdown-option download-file" type="submit">
      <span class="material-symbols-outlined icon">download</span>
      <span>Download</span>
    </button>
  </form>
  <button class="file-dropdown-option rename-file">
    <span class="material-symbols-outlined icon">edit_square</span>
    <span>Rename</span>
  </button>
  <button class="file-dropdown-option move-file">
    <span class="material-symbols-outlined icon">drive_file_move</span>
    <span>Move</span>
  </button>
  <button class="file-dropdown-option file-details">
    <span class="material-symbols-outlined icon">info</span>
    <span>Details</span>
  </button>
  <button class="file-dropdown-option share-file">
    <span class="material-symbols-outlined icon">share</span>
    <span>Share</span>
  </button>
  <button class="file-dropdown-option delete-file">
    <span class="material-symbols-outlined icon">delete</span>
    <span>Move to trash</span>
  </button>
</div>