<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Xdrive - <%= title %></title>
  <link rel="icon" type="image/svg+xml" href="icons/light-logo.svg">
  <link rel="stylesheet" href="css/style.css">

</head>

<body>
  <div class="page-container login-page">

    <div class="logo-composite">
      <img class="logo" src="/icons/dark-logo.svg" alt="logo">
      <div>
        <h1 class="bold huge">Xdrive</h1>
        <p class="text-label gray small">Cloud Storage</p>
      </div>
    </div>

    <div class="form-wrapper">

      <div class="form-header">
        <h2 class="big medium">Log in to Xdrive</h2>
        <p class="text-label gray small">Welcome back. Please enter your details.</p>
      </div>


      <form action="/login" method="post">
        <div class="input-wrapper email">
          <label class="text-label small gray" for="email">EMAIL</label>
          <input id="email" name="email" type="email" placeholder="user@xdrive.com">
        </div>
        <div class="input-wrapper password">
          <label class="text-label small gray" for="password">PASSWORD</label>
          <input id="password" name="password" type="password" placeholder="Min. 8 characters">
        </div>
        <button type="submit" class="submit-button text-label normal">Log in</button>
      </form>

      <p class="signup-prompt text-label small gray">Don't have an account? <a href="/signup">Sign up</a></p>
    </div>

  </div>

</body>

</html>