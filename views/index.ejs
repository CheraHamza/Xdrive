<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Xdrive -
    <%= title %>
  </title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/icons/light-logo.svg">
  <script src="/js/items.js" type="module"></script>
  <script src="/js/forms.js" defer></script>
</head>

<body>
  <div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

  <div class="page-container home-page <%= locals.isAuthenticated ? "has-navbar" : "" %>">
    <% if (locals.isAuthenticated) { %>
    <%- include("partials/modals") %>
    <%- include("partials/navbar") %>
    <% } %>
    <section class="main-wrapper">
      <%- include("partials/header") %>
      <% if (locals.location) {%>
      <%- include("partials/location-bar") %>
      <% } %>
      <% if (locals.title === "Trash") { %>
      <button class="empty-trash-btn">
        <span class="material-symbols-outlined"></span>
        <span>Empty trash</span>
      </button>
      <% } %>
      <% if (locals.isSharedBrowse) { %>
      <div class="items-container">
        <% const hasItems = (locals.folders && locals.folders.length > 0) || (locals.files && locals.files.length > 0); %>
        <% if (hasItems) { %>
        <% if (locals.folders && locals.folders.length > 0) { %>
        <p class="text-label thin gray">Folders</p>
        <div class="folders-container">
          <% folders.forEach(folder => { %>
          <%- include("partials/grid-item", {item: folder, isFolder: true, sharedBrowse: true}) %>
          <% }) %>
        </div>
        <% } %>
        <% if (locals.files && locals.files.length > 0) { %>
        <p class="text-label thin gray">Files</p>
        <div class="files-container">
          <% files.forEach(file => { %>
          <%- include("partials/grid-item", {item: file, isFolder: false, sharedBrowse: true}) %>
          <% }) %>
        </div>
        <% } %>
        <% } else { %>
        <%- include("partials/empty-state") %>
        <% } %>
      </div>
      <% } else if (locals.title === "Share") {%>
      <%- include("partials/item-card") %>
      <% } else { %>

      <div class="items-container">
        <% const hasItems = (locals.folders && locals.folders.length > 0) || (locals.files && locals.files.length > 0); %>

        <% if (hasItems) { %>
        <% if (locals.folders && locals.folders.length > 0) {%>
        <p class="text-label thin gray">Folders</p>
        <div class="folders-container">
          <% folders.forEach(folder => { %>
          <%- include("partials/grid-item", {item: folder, isFolder: true}) %>
          <% }) %>
        </div>
        <% } %>
        <% if (locals.files && locals.files.length > 0) {%>
        <p class="text-label thin gray">Files</p>
        <div class="files-container">
          <% files.forEach(file => { %>
          <%- include("partials/grid-item", {item: file, isFolder: false}) %>
          <% }); %>
        </div>
        <% } %>
        <% } else { %>
        <%- include("partials/empty-state") %>
        <% } %>
      </div>

      <% } %>

    </section>
  </div>
</body>

</html>