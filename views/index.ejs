<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Xdrive -
    <%= title %>
  </title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/icons/light-logo.svg">
  <script src="/js/items.js" type="module"></script>
</head>

<body>
  <div class="page-container home-page">
    <%- include("partials/modals") %>
    <%- include("partials/navbar") %>
    <section class="main-wrapper">
      <%- include("partials/header") %>
      <%- include("partials/location-bar") %>
      <div class="items-container">

        <p class="text-label thin gray">Folders</p>
        <div class="folders-container">
          <% if (locals.folders) { %>
          <% folders.forEach(folder => { %>
          <%- include("partials/grid-item", {item: folder, isFolder: true}) %>
          <% }) %>
          <% } %>
        </div>
        <p class="text-label thin gray">Files</p>
        <div class="files-container">
          <% if (locals.files) { %>
          <% files.forEach(file => { %>
          <%- include("partials/grid-item", {item: file, isFolder: false}) %>
          <% }); %>
          <% } %>
        </div>
      </div>

    </section>
  </div>
</body>

</html>